    "check-licenses": "node check-licenses.js",
    "lint": "eslint --ext=js,cjs ."
  },
  "keywords": [
    "license",
    "licenses"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "spdx-license-list": "^6.12.0"
  }
}
