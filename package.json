{
  "name": "license-types",
  "type": "module",
  "version": "4.0.1",
  "description": "A rough classification of licenses such as by aspects of permissiveness",
  "author": {
    "name": "Brett Zamir",
    "url": "http://brett-zamir.me/"
  },
  "contributors": [],
  "homepage": "https://github.com/brettz9/license-types",
  "bugs": "https://github.com/brettz9/license-types/issues",
  "repository": "https://github.com/brettz9/brettz9/license-types",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "types": "./dist/index.d.ts",
  "main": "index.js",
  "scripts": {
    "prepublishOnly": "pnpm tsc && pnpm build && pnpm attw",
    "tsc": "tsc",
    "attw": "attw --pack . --profile esm-only node16",
